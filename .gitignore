# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
*.egg-link
*.pyc
*.pyo

# Virtual environments
venv/
env/
.env
.venv
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Alembic
alembic/versions/*.py
!alembic/versions/.gitkeep

# Storage — never commit generated files
storage/reports/*
storage/temp/*
!storage/reports/.gitkeep
!storage/temp/.gitkeep

# Environment files — NEVER commit
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Docker
.dockerignore
