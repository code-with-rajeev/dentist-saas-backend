# ============================================================
# .env.example — Template for all environment variables
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
APP_ENV=development              # development | staging | production
APP_DEBUG=true                   # true only in development
APP_SECRET_KEY=change-me-in-production-use-256-bit-random-string

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://dentist:dentist123@localhost:5432/dentist_db

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret-use-256-bit-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# CORS (only used in staging/production — dev allows all)
# Comma-separated list of allowed origins
# ------------------------------------------------------------
ALLOWED_ORIGINS=https://yourfrontend.com

# ------------------------------------------------------------
# PDF Storage
# ------------------------------------------------------------
PDF_STORAGE_PATH=./storage/reports

# ------------------------------------------------------------
# Redis — POST-MVP (uncomment when Celery is activated)
# ------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Celery — POST-MVP (uncomment when task queue is activated)
# ------------------------------------------------------------
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------
# WhatsApp — POST-MVP (stubbed in MVP)
# ------------------------------------------------------------
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0
# WHATSAPP_TOKEN=your-meta-cloud-api-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
